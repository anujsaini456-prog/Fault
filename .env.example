# Copy to .env and replace every value. Never commit .env.

# Public hostname Caddy serves on. "localhost" gives a locally-trusted cert.
FS_DOMAIN=localhost

# Postgres superuser (used only by the container itself).
POSTGRES_PASSWORD=change-me-postgres
# Schema owner: runs migrations. Bypasses RLS, never used by request handlers.
FS_DB_OWNER_PASSWORD=change-me-owner
# Application role: what the API connects as. Subject to Row-Level Security.
FS_DB_APP_PASSWORD=change-me-app

# 64+ random chars, e.g.  python -c "import secrets;print(secrets.token_urlsafe(64))"
FS_JWT_SECRET=change-me-to-a-long-random-string

# Optional separate key for encrypting sensitive columns (TOTP secrets). 32+ random chars.
FS_DATA_KEY=

# Demo seed: first admin account (MFA enrolment is forced on first sign-in).
FS_SEED_ADMIN_EMAIL=admin@example.com
FS_SEED_ADMIN_PASSWORD=ChangeMe-Admin-2026!
# Demo seed: a second organisation's executive, used to show tenant isolation.
FS_SEED_EXEC_PASSWORD=ChangeMe-Exec-2026!
